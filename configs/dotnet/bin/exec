#!/usr/bin/env bash
# Run the dotnet CLI at the SDK version pinned in global.json.  Example:
#   bin/exec format --verify-no-changes
set -euo pipefail

cd "$(dirname "$0")/.."

if ! command -v dotnet > /dev/null; then
  echo 'dotnet is not installed.  See https://dot.net/' >&2
  exit 1
fi

# dotnet reads global.json and fails if the pinned SDK is not installed.
exec dotnet "$@"
