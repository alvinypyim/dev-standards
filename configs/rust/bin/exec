#!/usr/bin/env bash
# Run cargo with the toolchain pinned in rust-toolchain.toml.  Example:
#   bin/exec clippy --all-targets -- -D warnings
set -euo pipefail

cd "$(dirname "$0")/.."

if ! command -v cargo > /dev/null; then
  echo 'cargo is not installed.  See https://rustup.rs/' >&2
  exit 1
fi

# rustup reads rust-toolchain.toml and installs the pinned toolchain.
exec cargo "$@"
