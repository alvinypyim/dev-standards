#!/usr/bin/env bash
# Run a command in the project's pinned Python environment.  Example:
#   bin/exec ruff check .
set -euo pipefail

cd "$(dirname "$0")/.."

if ! command -v uv > /dev/null; then
  echo 'uv is not installed.  See https://docs.astral.sh/uv/' >&2
  exit 1
fi

# --locked fails if uv.lock is out of date, like yarn install --immutable.
exec uv run --locked -- "$@"
